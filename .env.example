# --- ZKBio CVAccess (se capturan igual que en APPS-BIO, ver su .env.example) ---
# Recomendado: un usuario de ZKBio exclusivo para este servicio, para que su
# sesion no choque con la de APPS-BIO.
ZKBIO_URL=
ZKBIO_API_USER=admin
ZKBIO_API_PASSWORD_HASH=
ZKBIO_BROWSER_TOKEN=

# Certificado de ZKBio (.pem, ruta relativa al repo) para validar TLS.
# Si se deja vacio se usa ZKBIO_VERIFICAR_SSL (false = sin validar, como app.py).
ZKBIO_CERTIFICADO=
ZKBIO_VERIFICAR_SSL=false
ZKBIO_TIMEOUT=20
ZKBIO_VIGENCIA_SESION=900

# Cuantos resultados recientes muestra GET /api/estado.
SYNC_RESULTADOS_RECIENTES=100
